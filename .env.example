# Groq API Configuration
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model Selection
# Recommended default models: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Pipeline Settings
RELAY_PROVIDER=groq
RELAY_DEFAULT_CHUNK_SIZE=500
RELAY_DEFAULT_TOP_K=5
RELAY_USE_RERANKING=false
RELAY_MAX_RETRIEVAL_ATTEMPTS=2
RELAY_MAX_VALIDATION_ATTEMPTS=2

# Concurrency & Admission
RELAY_MAX_CONCURRENCY=4
RELAY_MAX_QUEUE_SIZE=20
RELAY_REQUEST_TIMEOUT_SECONDS=60.0
